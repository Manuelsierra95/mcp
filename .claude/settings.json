{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__brain__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/packages/brain-hooks/claude/brain-call.ts"]
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/packages/brain-hooks/claude/guard-write.ts"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/packages/brain-hooks/claude/guard-stop.ts"]
          }
        ]
      }
    ]
  }
}
